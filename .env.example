# Copy to .env and fill in locally. Never commit the real .env file.
# No real token values belong in this example file.

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BATCH_POLL_INTERVAL_SECONDS=30

# --- Local storage ---
RESEARCH_DATA_DIR=./data
RESEARCH_DATABASE_PATH=./data/research.sqlite3

# --- Reddit MCP ---
# REDDIT_MCP_MODE: "stdio" (local, e.g. npx reddit-mcp-server) or "http" (remote read-only server)
REDDIT_MCP_MODE=stdio
REDDIT_MCP_COMMAND=npx -y reddit-mcp-server
REDDIT_MCP_URL=
REDDIT_MCP_AUTH_TOKEN=

# --- Reddit API app (read-only) ---
# Anonymous Reddit API access is blocked (HTTP 403, verified 2026-07-11) —
# register a Reddit app and set client id/secret for live collection.
# Do NOT set REDDIT_USERNAME/REDDIT_PASSWORD: leaving them unset keeps the
# MCP server's write tools (create_post, reply, edit, delete) inoperable.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Robinhood MCP (capability inspection + read-only context only; never used to trade) ---
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# --- Logging ---
LOG_LEVEL=INFO

# --- Alpaca paper-broker credentials (Milestone 4 isolated LumiBot paper-runtime process ONLY) ---
# Read exclusively by the isolated `paper_runtime` process
# (paper_runtime/src/trading_paper_runtime/configuration.py) — the main
# trading-desk process never reads these. ALPACA_IS_PAPER must be exactly
# "true"; anything else (including leaving it unset) fails closed and
# blocks order submission. There is no production/live equivalent wired up
# anywhere in this repository.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_IS_PAPER=true

# --- Alpaca market-data credentials (Milestone 6 real evidence providers) ---
# Deliberately DISTINCT env-var names from ALPACA_API_KEY/ALPACA_API_SECRET
# above, even though Alpaca accepts the same key pair for both: the
# Milestone 4 invariant that the main trading-desk process never reads the
# paper-broker credential pair stays literally true. Read by
# src/trading_research/config.py and used only for read-only market-data
# HTTP calls (quotes/historical bars) from the main process — never for
# order submission, which remains exclusively the isolated paper_runtime
# process's responsibility via ALPACA_API_KEY/ALPACA_API_SECRET above.
ALPACA_MARKET_DATA_API_KEY=
ALPACA_MARKET_DATA_API_SECRET=
