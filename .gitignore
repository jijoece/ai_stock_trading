__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Secrets — never commit
.env

# Generated research artifacts (contain third-party content / run-specific data)
data/*.sqlite3
data/*.sqlite3-*
research-input/*.json
research-input/*.md
!research-input/.gitkeep
research-results/raw/*
research-results/validated/*
research-results/failed/*
research-results/retries/*
!research-results/raw/.gitkeep
!research-results/.gitkeep
research-results/*.json
research-results/*.md
research-results/*.sqlite
research-results/*.sqlite3
research-results/*.sqlite3-*
research-results/*.db
!research-results/.gitkeep

# Message Batch run artifacts (contain generated patches / results, not source)
batch/runs/*
!batch/runs/.gitkeep

# Dashboard runtime state (PID/log files, not source)
data/.dashboard_runtime/

.DS_Store
