#!/usr/bin/env bash
set -euo pipefail
umask 077

# Operator-configured absolute paths and bounded symbols.
REPO_DIR="/path/to/agentic-trading-desk"
LOG_DIR="/path/to/agentic-trading-desk/logs/shadow"
PYTHON_BIN="$REPO_DIR/.venv/bin/python"
SYMBOLS=(AAPL)

if [[ "$REPO_DIR" == "/path/to/agentic-trading-desk" ]]; then
  echo "REPO_DIR is still a placeholder" >&2
  exit 1
fi
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "configured Python interpreter is not executable" >&2
  exit 1
fi

/bin/mkdir -p "$LOG_DIR"

CLAUDE_CODE_OAUTH_TOKEN="$(
  /usr/bin/security find-generic-password \
    -a "$USER" \
    -s agentic-trading-desk-claude-oauth \
    -w
)"
if [[ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]]; then
  echo "Claude Code OAuth token was not found in Keychain" >&2
  exit 1
fi
export CLAUDE_CODE_OAUTH_TOKEN

unset ANTHROPIC_API_KEY || true
unset ANTHROPIC_AUTH_TOKEN || true
unset ANTHROPIC_BASE_URL || true

ARGS=(
  -m trading_research.cli
  run-due-shadow-cycle
  --provider-mode real
  --research-config "$REPO_DIR/config/production/research.yaml"
  --scheduled-research-config "$REPO_DIR/config/production/scheduled_research.yaml"
  --shadow-config "$REPO_DIR/config/production/shadow_operations.yaml"
)
for symbol in "${SYMBOLS[@]}"; do
  ARGS+=(--symbol "$symbol")
done

TIMESTAMP="$(/bin/date -u +%Y%m%dT%H%M%SZ)"
cd "$REPO_DIR"
exec "$PYTHON_BIN" "${ARGS[@]}" >> "$LOG_DIR/shadow-cycle-${TIMESTAMP}.log" 2>&1
