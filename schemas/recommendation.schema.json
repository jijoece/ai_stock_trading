{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recommendation.schema.json",
  "title": "Frozen research recommendation",
  "description": "Immutable record of one research recommendation. Research output only — never an instruction to trade. Frozen at creation; evaluation writes elsewhere.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rec_id",
    "symbol",
    "side",
    "ts",
    "status",
    "score",
    "factors",
    "data_timestamps",
    "model_version",
    "prompt_version",
    "config_hash",
    "git_sha",
    "disclaimer"
  ],
  "allOf": [
    {
      "description": "An incomplete analysis must never carry executable order details.",
      "if": { "properties": { "status": { "const": "analysis_incomplete" } } },
      "then": {
        "properties": {
          "risk_plan": { "type": "null" },
          "missing_data_reasons": { "type": "array", "minItems": 1 }
        },
        "required": ["missing_data_reasons"]
      }
    },
    {
      "description": "A no-action or screened-out result carries no order details either.",
      "if": { "properties": { "side": { "enum": ["no_action", "analysis_incomplete", "screened_out"] } } },
      "then": { "properties": { "risk_plan": { "type": "null" } } }
    }
  ],
  "properties": {
    "rec_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": ["string", "null"] },
    "symbol": { "type": "string", "pattern": "^[A-Z]{1,5}$" },
    "side": {
      "type": "string",
      "enum": ["buy_candidate", "watch", "no_action", "analysis_incomplete", "screened_out"]
    },
    "ts": { "type": "string", "format": "date-time" },
    "price_at_rec": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "status": { "type": "string", "enum": ["active", "expired", "analysis_incomplete"] },
    "acted": { "type": "boolean", "default": false },
    "rationale_text": { "type": "string" },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factor", "weight", "contribution"],
        "properties": {
          "factor": { "type": "string", "minLength": 1 },
          "raw_value": { "type": ["number", "string", "null"] },
          "normalized": { "type": ["number", "null"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "contribution": { "type": ["number", "null"] }
        }
      }
    },
    "risk_plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "shares": { "type": "integer", "minimum": 0 },
        "entry_price": { "type": "number", "minimum": 0 },
        "stop_price": { "type": "number", "minimum": 0 },
        "target_price": { "type": "number", "minimum": 0 },
        "risk_per_share": { "type": "number", "minimum": 0 },
        "dollars_at_risk": { "type": "number", "minimum": 0 },
        "position_value": { "type": "number", "minimum": 0 },
        "reward_risk": { "type": "number", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "missing_data_reasons": {
      "type": "array",
      "description": "Why the analysis failed closed — one entry per missing/stale input.",
      "items": { "type": "string", "minLength": 1 }
    },
    "data_timestamps": {
      "type": "object",
      "description": "Freshness audit: source name → ISO timestamp of the data used.",
      "additionalProperties": { "type": "string" }
    },
    "reddit_component": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "weight": { "type": "number", "minimum": 0, "maximum": 0.10 },
        "net_sentiment": { "type": "number", "minimum": -1, "maximum": 1 },
        "total_mentions": { "type": "integer", "minimum": 0 },
        "unique_authors": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "model_version": { "type": "string" },
    "prompt_version": { "type": "string" },
    "config_hash": {
      "type": "string",
      "description": "SHA-256 over the non-secret configuration used for this run.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "description": "Repository commit the code ran from; 'unknown' when unavailable.",
      "pattern": "^([0-9a-f]{7,40}|unknown)$"
    },
    "frozen": { "type": "boolean", "const": true },
    "disclaimer": {
      "type": "string",
      "const": "Research output only. Not financial advice. Not an instruction to trade."
    }
  }
}
